---
import MainLayout from '../layouts/MainLayout.astro';

const en = Astro.url.pathname.startsWith('/en');
---

<MainLayout title="404 | Mistral Impianti" description={en ? 'Page not found.' : 'Pagina non trovata.'} lang={en ? 'en' : 'it'}>
  <div class="error-page" data-animate="fade-up">
    <p class="error-code">404</p>
    <h1 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">{en ? 'Page not found' : 'Pagina non trovata'}</h1>
    <p class="mt-4 max-w-md text-sm leading-relaxed text-zinc-600">
      {en ? 'The page you are looking for does not exist or has been moved.' : 'La pagina che stai cercando non esiste o è stata spostata.'}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={en ? '/en/' : '/'} class="btn btn-dark">{en ? 'Back to home' : 'Torna alla home'}</a>
      <a href={en ? '/en/contatti' : '/contatti'} class="btn btn-outline">{en ? 'Contact us' : 'Contattaci'}</a>
    </div>
  </div>
</MainLayout>
