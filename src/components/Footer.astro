---
interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const navLinks =
  lang === 'en'
    ? [
        { name: 'Home', href: '/en/' },
        { name: 'Company', href: '/en/azienda' },
        { name: 'Services', href: '/en/servizi' },
        { name: 'Projects', href: '/en/lavori' },
        { name: 'Partners', href: '/en/partners' },
        { name: 'Contact', href: '/en/contatti' },
      ]
    : [
        { name: 'Home', href: '/' },
        { name: "L'azienda", href: '/azienda' },
        { name: 'Servizi', href: '/servizi' },
        { name: 'Lavori', href: '/lavori' },
        { name: 'Partners', href: '/partners' },
        { name: 'Contatti', href: '/contatti' },
      ];

const t =
  lang === 'en'
    ? {
        heading: 'Over thirty years of technological systems serving businesses.',
        nav: 'Navigation',
        hq: 'Head office',
        address: 'Via del Lavoro 17<br />12062 Cherasco (CN), Italy',
        contacts: 'Contacts',
        hours: 'Mon–Fri: 8:30–12:30 / 14:00–18:00',
      }
    : {
        heading: "Oltre trent'anni di impianti tecnologici al servizio delle aziende.",
        nav: 'Navigazione',
        hq: 'Sede',
        address: 'Via del Lavoro 17<br />12062 Cherasco (CN)',
        contacts: 'Contatti',
        hours: 'Lun–Ven: 8:30–12:30 / 14:00–18:00',
      };
---
<footer class="site-footer">
  <div class="site-footer-glow" aria-hidden="true"></div>
  <div class="site-footer-grid">
    <div class="space-y-6">
      <div class="inline-flex items-center gap-3">
        <img src="/logo.jpg" alt="" class="h-12 w-12 rounded-lg object-cover ring-1 ring-white/10" loading="lazy" />
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-white/70">Mistral Impianti</p>
          <p class="text-lg font-bold text-white">S.R.L.</p>
        </div>
      </div>
      <h2 class="max-w-md text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl">
        {t.heading}
      </h2>
      <div class="flex gap-3">
        <a href="https://www.instagram.com/mistral.impianti/" target="_blank" rel="noopener" aria-label="Instagram" class="footer-social" title="Instagram">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://it.linkedin.com/company/mistral-impianti-s-r-l" target="_blank" rel="noopener" aria-label="LinkedIn" class="footer-social" title="LinkedIn">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 114.126 0 2.063 2.063 0 01-2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-white/65">{t.nav}</p>
      <ul class="mt-5 space-y-3">
        {navLinks.map((link) => (
          <li><a href={link.href} class="footer-link">{link.name}</a></li>
        ))}
      </ul>
    </div>

    <div class="space-y-8">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-white/65">{t.hq}</p>
        <p class="mt-4 text-base font-semibold leading-relaxed text-white" set:html={t.address}></p>
        <p class="mt-3 text-sm text-white/70">PEC: mistralimpianti@pec.it</p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-white/65">{t.contacts}</p>
        <div class="mt-4 space-y-2 text-base">
          <a href="tel:0172754010" class="footer-link block font-semibold text-white hover:text-white">0172 754010</a>
          <a href="tel:3281022102" class="footer-link block font-semibold text-white hover:text-white">328 1022102</a>
          <a href="mailto:info@mistralimpianti.it" class="footer-link block font-semibold text-white hover:text-white">info@mistralimpianti.it</a>
        </div>
        <p class="mt-4 text-sm text-white/65">{t.hours}</p>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/8">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm text-white/45 sm:flex-row">
      <p>&copy; {new Date().getFullYear()} Mistral Impianti S.R.L.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs">
        <span>P.IVA 02792480044</span>
        <span>ISO 9001</span>
        <a href="https://bitora.it" target="_blank" rel="noopener" class="font-medium text-white/70 hover:text-white">bitora.it</a>
      </div>
    </div>
  </div>
</footer>
