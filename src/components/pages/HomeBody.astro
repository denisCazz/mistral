        { title: 'Impianti elettrici', text: 'Progettazione e installazione per industria e terziario.' },
        { title: 'Sistemi antincendio', text: 'Rilevazione, spegnimento e manutenzione certificata.' },
        { title: 'Automazione', text: 'Programmazione e integrazione di sistemi intelligenti.' },
        { title: 'Climatizzazione', text: 'Comfort, efficienza e controllo degli ambienti.' },
        { title: 'Fotovoltaico', text: 'Produzione energetica per aziende e abitazioni.' },
        { title: 'Manutenzione', text: 'Continuità operativa e interventi programmati.' },
      ],
      more: 'Approfondisci',
      certEyebrow: 'Standard certificati',
      certTitle: 'Qualità dimostrabile.<br />Sicurezza verificabile.',
      certDesc: 'Processi controllati, personale qualificato e aggiornamento continuo. Le certificazioni non sono un bollino: sono il nostro metodo di lavoro.',
      certBtn1: 'Visualizza ISO 9001',
      certBtn2: 'Tutte le certificazioni',
      certs: [
        { img: '/iso.png', alt: 'Certificazione ISO 9001', strong: 'ISO 9001', span: 'Sistema gestione qualità' },
        { img: '/fgas.png', alt: 'Certificazione F-GAS', strong: 'F-GAS', span: 'Personale e impresa certificati' },
        { img: '/siemens.jpg', alt: 'Siemens technical partner', strong: 'Siemens', span: 'Technical partner da oltre 20 anni' },
      ],
      teaserEyebrow: 'Mistral Impianti',
      teaserTitle: 'Radici artigiane.<br />Scala industriale.',
      teaserDesc: 'Da Cherasco lavoriamo per clienti nazionali e internazionali. Un team di 21 persone unisce esperienza sul campo, programmazione e assistenza.',
      teaserLink: "Scopri l'azienda",
      ctaTitle: 'Dal concept alla manutenzione, un unico partner tecnologico.',
      ctaDesc: "Dalla progettazione alle verifiche periodiche, coordiniamo team multidisciplinari per impianti elettrici, speciali, antincendio e sistemi intelligenti.",
