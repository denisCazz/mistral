        { title: 'Fire protection', text: 'Detection, suppression and certified maintenance.' },
        { title: 'Automation', text: 'Programming and integration of smart systems.' },
        { title: 'HVAC', text: 'Comfort, efficiency and environmental control.' },
        { title: 'Photovoltaic', text: 'Energy production for businesses and homes.' },
        { title: 'Maintenance', text: 'Operational continuity and scheduled interventions.' },
      ],
      more: 'Learn more',
      certEyebrow: 'Certified standards',
      certTitle: 'Provable quality.<br />Verifiable safety.',
      certDesc: 'Controlled processes, qualified staff and continuous training. Certifications are not a badge: they are our way of working.',
      certBtn1: 'View ISO 9001',
      certBtn2: 'All certifications',
      certs: [
        { img: '/iso.png', alt: 'ISO 9001 certification', strong: 'ISO 9001', span: 'Quality management system' },
        { img: '/fgas.png', alt: 'F-GAS certification', strong: 'F-GAS', span: 'Certified staff and company' },
        { img: '/siemens.jpg', alt: 'Siemens technical partner', strong: 'Siemens', span: 'Technical partner for over 20 years' },
      ],
      teaserEyebrow: 'Mistral Impianti',
      teaserTitle: 'Craft roots.<br />Industrial scale.',
      teaserDesc: 'From Cherasco we work for national and international clients. A 21-person team combines field experience, programming and after-sales service.',
      teaserLink: 'Discover the company',
      ctaTitle: 'From concept to maintenance, one single technology partner.',
      ctaDesc: 'From design to periodic inspections, we coordinate multidisciplinary teams for electrical, special, fire-protection and smart systems.',
      address: 'Via del Lavoro 17 · Cherasco (CN), Italy',
    }
  : {
      kicker: 'Impianti tecnologici dal 1988',
      h1a: 'Energia, sicurezza',
      h1b: 'e controllo.',
      lead: "Progettiamo e manteniamo infrastrutture affidabili per aziende, industria e terziario. Un solo partner, dalla progettazione all'assistenza.",
      cta1: 'Scopri le soluzioni',
      cta2: 'Parliamo del progetto',
      photo: 'Foto:',
      stats: [
        { label: 'Persone', value: '21', detail: 'Tecnici, programmatori e installatori specializzati.' },
        { label: 'Fatturato 2025', value: '€ 2,7M', detail: 'Crescita costruita su qualità, competenza e continuità.' },
        { label: 'Esperienza', value: '38 anni', detail: 'Impianti tecnologici per aziende dal 1988.' },
      ],
      growthEyebrow: 'Crescita',
      growthTitle: 'Tre anni, una direzione chiara.',
      growthDesc: 'Fatturato e utile mostrano una crescita costante, sostenuta da investimenti nelle persone e nelle competenze.',
      growthLink: 'Dati aziendali',
      revenue: 'Fatturato',
      revenueTitle: 'Ricavi annuali',
      revenueAria: 'Fatturato: 1,9 milioni nel 2023, 2,20 milioni nel 2024, 2,74 milioni nel 2025',
      profit: 'Utile',
      profitTitle: "Risultato d'esercizio",
      profitAria: 'Utile: 517 mila euro nel 2023, 665 mila euro nel 2024, 781 mila euro nel 2025',
      dataNote: 'Valori 2023 indicativi. Dati economici forniti dal committente.',
