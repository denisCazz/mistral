---
import SectionHeader from '../ui/SectionHeader.astro';
import CTA from '../ui/CTA.astro';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const L = lang === 'en' ? '/en' : '';
const en = lang === 'en';

const t = en
