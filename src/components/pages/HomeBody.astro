      cta1: 'Explore solutions',
      cta2: 'Discuss your project',
      photo: 'Photo:',
      stats: [
        { label: 'People', value: '21', detail: 'Specialised technicians, programmers and installers.' },
        { label: '2025 revenue', value: '€ 2.7M', detail: 'Growth built on quality, expertise and continuity.' },
        { label: 'Experience', value: '38 years', detail: 'Technological systems for businesses since 1988.' },
      ],
      growthEyebrow: 'Growth',
      growthTitle: 'Three years, one clear direction.',
      growthDesc: 'Revenue and profit show steady growth, supported by investment in people and skills.',
      growthLink: 'Company data',
      revenue: 'Revenue',
      revenueTitle: 'Annual revenue',
      revenueAria: 'Revenue: 1.9 million in 2023, 2.20 million in 2024, 2.74 million in 2025',
      profit: 'Profit',
