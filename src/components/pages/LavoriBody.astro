  { titolo: 'Riva', cliente: 'Riva', tipologie: ['Impianti antincendio'], descrizione: 'Installazione e manutenzione di impianti antincendio.', immagine: '/riva.jpg' },
  { titolo: 'Qmatic', cliente: 'Qmatic', tipologie: ['Impianti eliminacode'], descrizione: 'Sistemi di gestione code per uffici pubblici e privati.', immagine: '/qmatic.jpg' },
