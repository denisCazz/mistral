const tipologieEn: Record<string, string> = {
  'Impianti antincendio': 'Fire-protection systems',
  'Sale operatorie': 'Operating theatres',
  'Impianti elettrici': 'Electrical systems',
  'Fibra ottica': 'Fibre optics',
  'Manutenzione': 'Maintenance',
  'BMS': 'BMS',
  'TVCC': 'CCTV',
  'Antintrusione': 'Intrusion detection',
  'Poli logistici in tutta Italia': 'Logistics hubs across Italy',
  'Collaudi': 'Testing & commissioning',
  'Impianti rivelazione fumi': 'Smoke detection systems',
  'Impianti rivelazione gas': 'Gas detection systems',
  'Impianti di evacuazione': 'Evacuation systems',
  'EVAC': 'EVAC',
  'Impianti antitaccheggio': 'Anti-theft systems',
  'Impianti eliminacode': 'Queue management systems',
};

const descrizioniEn: Record<string, string> = {
  'Installazione e manutenzione di impianti specializzati per strutture sanitarie.': 'Installation and maintenance of specialised systems for healthcare facilities.',
  "Collaborazione con Siemens per l'implementazione di soluzioni tecnologiche avanzate.": 'Collaboration with Siemens on the implementation of advanced technological solutions.',
  'Installazione di sistemi complessi per centri logistici in tutta Italia.': 'Installation of complex systems for logistics centres across Italy.',
  'Sistemi di sicurezza e rilevazione per ambienti industriali.': 'Safety and detection systems for industrial environments.',
  'Sistemi di sicurezza e evacuazione per edifici pubblici.': 'Safety and evacuation systems for public buildings.',
  'Installazione di sistemi di sicurezza per impianti industriali.': 'Installation of safety systems for industrial plants.',
  'Soluzioni antitaccheggio per il settore retail.': 'Anti-theft solutions for the retail sector.',
  'Installazione e manutenzione di impianti antincendio.': 'Installation and maintenance of fire-protection systems.',
  'Sistemi di gestione code per uffici pubblici e privati.': 'Queue management systems for public and private offices.',
};

const tr = (p: Progetto) => ({
  ...p,
  tipologie: en ? p.tipologie.map((x) => tipologieEn[x] ?? x) : p.tipologie,
  descrizione: en ? descrizioniEn[p.descrizione] ?? p.descrizione : p.descrizione,
});

const t = en
  ? {
      heroEyebrow: 'Portfolio',
      heroTitle: 'Projects delivered with passion and technical expertise.',
      heroDesc: 'Installations for national and international clients: from design to scheduled maintenance.',
      heroImageAlt: 'Industrial automation control panel',
      asideClients: `${progetti.length}+ clients`,
      asideText: 'Collaborations with leading companies in the industrial, healthcare, logistics and commercial sectors.',
      clientsEyebrow: 'Clients',
      selectedTitle: 'Selected projects',
      hide: 'Hide all projects',
      show: 'Show all projects',
      counterEyebrow: 'Innovation',
      counterTitle: 'Mistral Counter',
      counterSub: 'Technology that enhances commercial spaces',
      counterText: 'A cutting-edge solution for monitoring and smart management of systems. It optimises consumption, improves energy efficiency and provides objective data on visibility and footfall.',
      counterPoints: [
        'Real-time consumption monitoring',
        'Intelligent analysis of energy data',
        'Differentiated fees per commercial location',
        'Objective data on footfall and access',
      ],
      download: 'Download brochure',
      view: 'View online',
      ctaTitle: 'Want a partner for your next project?',
      ctaDesc: 'From design to maintenance, we support companies across Italy.',
    }
  : {
      heroEyebrow: 'Portfolio',
      heroTitle: 'Progetti realizzati con passione e competenza tecnica.',
      heroDesc: 'Installazioni per clienti nazionali e internazionali: dalla progettazione alla manutenzione programmata.',
      heroImageAlt: 'Pannello di controllo per automazione industriale',
      asideClients: `${progetti.length}+ clienti`,
      asideText: 'Collaborazioni con aziende leader nei settori industriale, sanitario, logistico e commerciale.',
      clientsEyebrow: 'Clienti',
      selectedTitle: 'Progetti selezionati',
      hide: 'Nascondi tutti i progetti',
      show: 'Mostra tutti i progetti',
      counterEyebrow: 'Innovazione',
      counterTitle: 'Mistral Counter',
      counterSub: 'Tecnologia per valorizzare gli spazi commerciali',
      counterText: "Soluzione all'avanguardia per il monitoraggio e la gestione intelligente degli impianti. Ottimizza i consumi, migliora l'efficienza energetica e fornisce dati oggettivi su visibilità e traffico.",
      counterPoints: [
        'Monitoraggio in tempo reale dei consumi',
        'Analisi intelligente dei dati energetici',
        'Canoni differenziati per posizione commerciale',
        'Dati oggettivi su passaggi e accessi',
      ],
      download: 'Scarica brochure',
      view: 'Visualizza online',
      ctaTitle: 'Vuoi un partner per il tuo prossimo progetto?',
      ctaDesc: 'Dalla progettazione alla manutenzione, supportiamo aziende in tutta Italia.',
    };
---

<PageHero
  eyebrow={t.heroEyebrow}
  title={t.heroTitle}
  description={t.heroDesc}
  image="https://images.unsplash.com/photo-1755407454675-454d6ed4c1bc?auto=format&fit=crop&w=1800&q=82"
  imageAlt={t.heroImageAlt}
  imagePosition="center 45%"
>
  <div slot="aside" class="hero-aside-card">
    <p class="hero-aside-title">{t.asideClients}</p>
    <p class="mt-3">{t.asideText}</p>
  </div>
</PageHero>

<section class="section-shell mt-16 space-y-8 pb-8" data-animate="fade-up">
  <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
    <div>
      <p class="eyebrow">{t.clientsEyebrow}</p>
      <h2 class="text-2xl font-bold tracking-tight">{t.selectedTitle}</h2>
    </div>
    <button id="toggle-progetti-btn" class="btn btn-outline gap-3">
      <span id="toggle-text">{t.hide}</span>
      <svg id="toggle-icon" class="h-4 w-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </button>
  </div>

  <div id="progetti-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {progetti.map((progetto) => {
      const p = tr(progetto);
      return (
        <article class="portfolio-card">
          <div class="portfolio-card-logo">
            <img src={p.immagine} alt={`Logo ${p.cliente}`} class="max-h-20 w-full object-contain transition group-hover:scale-105" loading="lazy" />
          </div>
          <div class="space-y-3 p-5">
            <h2 class="text-base font-bold tracking-tight">{p.titolo}</h2>
            {p.descrizione && <p class="text-sm leading-relaxed text-zinc-600">{p.descrizione}</p>}
            {p.tipologie.length > 0 && (
              <div class="flex flex-wrap gap-1.5 pt-1">
                {p.tipologie.map((tipo) => (
                  <span class="tag text-[0.65rem]">{tipo}</span>
                ))}
              </div>
            )}
          </div>
        </article>
      );
    })}
  </div>
</section>

<section class="section-shell pb-24" data-animate="fade-up">
  <div class="surface-card overflow-hidden">
    <div class="grid lg:grid-cols-2">
      <div class="border-b border-black/8 p-8 sm:p-10 lg:border-b-0 lg:border-r">
        <p class="eyebrow">{t.counterEyebrow}</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight">{t.counterTitle}</h2>
        <p class="mt-2 text-sm text-zinc-600">{t.counterSub}</p>
        <p class="mt-6 text-sm leading-relaxed text-zinc-700">{t.counterText}</p>
        <ul class="mt-6 space-y-3 text-sm text-zinc-700">
          <li class="flex items-start gap-3"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-500"></span>{t.counterPoints[0]}</li>
          <li class="flex items-start gap-3"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500"></span>{t.counterPoints[1]}</li>
          <li class="flex items-start gap-3"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span>{t.counterPoints[2]}</li>
          <li class="flex items-start gap-3"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>{t.counterPoints[3]}</li>
        </ul>
      </div>
      <div class="flex flex-col items-center justify-center gap-4 bg-zinc-950 p-8 sm:p-10">
        <div class="w-full max-w-xs rounded-xl border border-white/10 bg-white/5 p-6 text-center text-white">
          <p class="text-4xl font-black tracking-tighter">MC</p>
          <p class="mt-2 text-xs font-bold uppercase tracking-[0.25em] text-white/45">Mistral Counter</p>
        </div>
        <a href="/pdf/MistralCounter.pdf" download class="btn btn-primary w-full max-w-xs">{t.download}</a>
        <a href="/pdf/MistralCounter.pdf" target="_blank" class="btn btn-secondary w-full max-w-xs">{t.view}</a>
      </div>
    </div>
  </div>
</section>

<CTA lang={lang} title={t.ctaTitle} description={t.ctaDesc} />

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('toggle-progetti-btn');
    const progettiGrid = document.getElementById('progetti-grid');
    const toggleText = document.getElementById('toggle-text');
    const toggleIcon = document.getElementById('toggle-icon');

    const lang = document.documentElement.lang === 'en' ? 'en' : 'it';
    const labels = {
      it: { hide: 'Nascondi tutti i progetti', show: 'Mostra tutti i progetti' },
      en: { hide: 'Hide all projects', show: 'Show all projects' },
    };

    let isVisible = true;

    toggleBtn?.addEventListener('click', () => {
      isVisible = !isVisible;

      if (progettiGrid) {
        if (isVisible) {
          progettiGrid.style.display = 'grid';
          if (toggleText) toggleText.textContent = labels[lang as 'it' | 'en'].hide;
          if (toggleIcon) toggleIcon.style.transform = 'rotate(0deg)';
        } else {
          progettiGrid.style.display = 'none';
          if (toggleText) toggleText.textContent = labels[lang as 'it' | 'en'].show;
          if (toggleIcon) toggleIcon.style.transform = 'rotate(180deg)';
        }
      }
    });
  });
</script>
