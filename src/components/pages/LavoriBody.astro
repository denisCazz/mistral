  { titolo: 'Siemens', cliente: 'Siemens', tipologie: ['Manutenzione', 'BMS', 'TVCC', 'Antintrusione', 'Impianti antincendio'], descrizione: "Collaborazione con Siemens per l'implementazione di soluzioni tecnologiche avanzate.", immagine: '/siemens.jpg' },
