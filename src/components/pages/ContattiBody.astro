---
import PageHero from '../ui/PageHero.astro';

interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;
const en = lang === 'en';

const t = en
  ? {
      heroEyebrow: 'Contact',
      heroTitle: 'Let’s talk about your next system.',
      heroDesc: 'Dedicated teams respond quickly for site surveys, design and scheduled maintenance.',
      heroImageAlt: 'Technician working on an industrial system',
      asideTitle: 'Office hours',
      asideHours: 'Monday – Friday: 8:30 – 12:30 / 14:00 – 18:00',
      asideClosed: 'Saturday – Sunday: closed',
      infoEyebrow: 'Information',
      infoTitle: 'How to contact us',
      labels: { address: 'Address', phone: 'Phone', mobile: 'Mobile', email: 'Email', pec: 'Certified email (PEC)' },
      address: 'Via del Lavoro 17, 12062 Cherasco (CN), Italy',
      companyData: 'Company details',
      revenue: '2024 revenue',
      mapTitle: 'How to reach us',
      mapNote: 'Cherasco · CN',
      mapIframeTitle: 'Map of the Mistral Impianti head office',
    }
  : {
      heroEyebrow: 'Contatti',
      heroTitle: 'Parliamo del tuo prossimo impianto.',
      heroDesc: 'Team dedicati rispondono rapidamente per sopralluoghi, progettazione e manutenzione programmata.',
      heroImageAlt: 'Tecnico al lavoro su un impianto industriale',
      asideTitle: 'Orari ufficio',
      asideHours: 'Lunedì – Venerdì: 8:30 – 12:30 / 14:00 – 18:00',
      asideClosed: 'Sabato – Domenica: chiuso',
      infoEyebrow: 'Informazioni',
      infoTitle: 'Come contattarci',
      labels: { address: 'Indirizzo', phone: 'Telefono', mobile: 'Cellulare', email: 'Email', pec: 'PEC' },
      address: 'Via del Lavoro 17, 12062 Cherasco (CN)',
      companyData: 'Dati societari',
      revenue: 'Fatturato 2024',
      mapTitle: 'Come raggiungerci',
      mapNote: 'Cherasco · CN',
      mapIframeTitle: 'Mappa sede Mistral Impianti',
    };

const contactItems = [
  { label: t.labels.address, value: t.address, href: null },
  { label: t.labels.phone, value: '0172 754010', href: 'tel:0172754010' },
  { label: t.labels.mobile, value: '328 1022102', href: 'tel:3281022102' },
  { label: t.labels.email, value: 'info@mistralimpianti.it', href: 'mailto:info@mistralimpianti.it' },
  { label: t.labels.pec, value: 'mistralimpianti@pec.it', href: 'mailto:mistralimpianti@pec.it' },
];
---

<PageHero
  eyebrow={t.heroEyebrow}
  title={t.heroTitle}
  description={t.heroDesc}
  image="https://images.unsplash.com/photo-1780034766226-6c2c62772512?auto=format&fit=crop&w=1800&q=82"
  imageAlt={t.heroImageAlt}
  imagePosition="center 36%"
>
  <div class="flex flex-wrap gap-3 md:col-span-2">
    <a href="tel:0172754010" class="contact-chip">0172 754010</a>
    <a href="tel:3281022102" class="contact-chip">328 1022102</a>
    <a href="mailto:info@mistralimpianti.it" class="contact-chip">info@mistralimpianti.it</a>
  </div>
  <div slot="aside" class="hero-aside-card">
    <p class="hero-aside-title">{t.asideTitle}</p>
    <p class="mt-3">{t.asideHours}</p>
    <p class="mt-1">{t.asideClosed}</p>
  </div>
</PageHero>

<section class="section-shell mt-16 grid gap-8 pb-24 lg:grid-cols-[0.85fr_1.15fr]" data-animate="fade-up">
  <div class="space-y-4">
    <p class="eyebrow">{t.infoEyebrow}</p>
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{t.infoTitle}</h2>
    <div class="mt-6 space-y-3">
      {contactItems.map((item) => (
        <div class="contact-row">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-zinc-950 text-white">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-zinc-400">{item.label}</p>
            {item.href ? (
              <a href={item.href} class="mt-1 block font-semibold hover:opacity-70">{item.value}</a>
            ) : (
              <p class="mt-1 font-semibold">{item.value}</p>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="dark-card mt-8">
      <p class="relative text-xs font-bold uppercase tracking-[0.25em] text-white/45">{t.companyData}</p>
      <dl class="relative mt-4 space-y-2 text-sm text-white/70">
        <div class="flex justify-between gap-4"><dt>P.IVA</dt><dd class="font-semibold text-white">02792480044</dd></div>
        <div class="flex justify-between gap-4"><dt>REA</dt><dd class="font-semibold text-white">236756</dd></div>
        <div class="flex justify-between gap-4"><dt>{t.revenue}</dt><dd class="font-semibold text-white">€ 2.196.706</dd></div>
      </dl>
    </div>
  </div>

  <div class="surface-card overflow-hidden" data-animate="zoom-in">
    <div class="flex items-center justify-between border-b border-black/8 px-6 py-5 sm:px-8">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">{t.mapTitle}</h2>
      <span class="hidden text-xs font-bold uppercase tracking-[0.25em] text-zinc-400 sm:block">{t.mapNote}</span>
    </div>
    <div class="h-[420px] w-full">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2822.8436243333126!2d7.8426319!3d44.9789332!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12d2a19b6b126c19%3A0xf0e61bafea7ed8a7!2sVia%20del%20Lavoro%2C%2017%2C%2012062%20Cherasco%20CN!5e0!3m2!1sit!2sit!4v1656528693897!5m2!1sit!2sit"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={t.mapIframeTitle}
      ></iframe>
    </div>
  </div>
</section>
